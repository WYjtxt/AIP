<template>
  <div
    class="SwiperBox"
    ref="SwiperBox"
    @mouseenter="MouseFun('移入')"
    @mouseleave="handleMouseLeave"
    @wheel.prevent="handleWheel"
    @mousedown="startDrag"
    @mousemove="onDrag"
    @mouseup.stop="stopDrag"
    @mouseleave.stop="stopDrag"
  >
    <div class="img-container" ref="containerRef">
      <div
        class="imgBox"
        :style="{
          transform: `translateX(${-currentOffset}px) scale(${scale})`,
          transition: isAnimating ? `${transitionDuration}s ease-in-out` : 'none',
        }"
      >
        <!-- 只渲染3张：前一张、当前张、下一张 -->
        <img 
          v-for="(src, index) in visibleImages" 
          :key="getImageKey(index)"
          :src="src" 
          alt="" 
        />
      </div>
    </div>

    <div class="leftBtn" @click="throttle(PrevFun)" v-if="imgList.length > 1">
      <i class="el-icon-arrow-left"></i>
    </div>
    <div class="rightBtn" @click="throttle(NextFun)" v-if="imgList.length > 1">
      <i class="el-icon-arrow-right"></i>
    </div>

    <div class="instBox" v-if="imgList.length > 1">
      <div
        @click="instFun(index)"
        v-for="(item, index) in imgList.length"
        :key="index"
        :class="['inst', index == imgShow ? 'instActv' : '']"
      />
    </div>
  </div>
</template>

<script>
export default {
  props: {
    imgList: {
      type: Array,
      default: () => [],
    },
    dialogOpen: {
      type: Boolean,
      default: false
    }
  },
  data() {
    return {
      imgShow: 0,
      currentOffset: 1,      // 初始显示中间那张（索引1）
      containerWidth: 0,
      
      scale: 1,
      dragX: 0,
      dragY: 0,
      lastX: 0,
      lastY: 0,
      dragging: false,
      
      transitionDuration: 0.5,
      isAnimating: true,
      timer: null,
      isThrottling: false,
      
      // 缓冲图片列表 [前一张, 当前张, 下一张]
      bufferImages: [],
    };
  },
  computed: {
    // 当前显示的3张图片
    visibleImages() {
      if (this.imgList.length === 0) return [];
      if (this.imgList.length === 1) return [this.imgList[0]];
      
      // 计算前一张、当前张、下一张的索引
      const prev = this.getPrevIndex(this.imgShow);
      const current = this.imgShow;
      const next = this.getNextIndex(this.imgShow);
      
      return [
        this.imgList[prev],
        this.imgList[current],
        this.imgList[next]
      ];
    }
  },
  watch: {
    imgList: {
      handler() {
        this.initSwiper();
      },
      deep: true,
      immediate: true
    },
    dialogOpen(val) {
      if (val) {
        this.$nextTick(() => {
          this.initSwiper();
        });
      } else {
        this.clearAutoPlay();
      }
    },
    // 监听偏移量变化，实现无限循环
    currentOffset(val) {
      if (this.imgList.length <= 1) return;
      
      // 向右滑到尽头（显示第3张后）
      if (val >= this.containerWidth * 2) {
        this.$nextTick(() => {
          this.isAnimating = false;
          // 重置到第1张（索引1）
          this.currentOffset = this.containerWidth;
          this.imgShow = this.getNextIndex(this.imgShow);
          this.$nextTick(() => {
            this.isAnimating = true;
          });
        });
      }
      
      // 向左滑到尽头（显示第1张后）
      if (val <= 0) {
        this.$nextTick(() => {
          this.isAnimating = false;
          // 重置到倒数第2张（索引1）
          this.currentOffset = this.containerWidth;
          this.imgShow = this.getPrevIndex(this.imgShow);
          this.$nextTick(() => {
            this.isAnimating = true;
          });
        });
      }
    }
  },
  mounted() {
    this.updateContainerWidth();
    window.addEventListener('resize', this.updateContainerWidth);
  },
  beforeDestroy() {
    this.clearAutoPlay();
    window.removeEventListener('resize', this.updateContainerWidth);
  },
  methods: {
    // ===== 获取前后索引 =====
    getPrevIndex(index) {
      return index === 0 ? this.imgList.length - 1 : index - 1;
    },
    getNextIndex(index) {
      return index === this.imgList.length - 1 ? 0 : index + 1;
    },
    
    // ===== 获取图片唯一key =====
    getImageKey(index) {
      return `${this.imgShow}_${index}`;
    },

    // ===== 获取容器实际宽度 =====
    updateContainerWidth() {
      if (this.$refs.containerRef) {
        this.containerWidth = this.$refs.containerRef.offsetWidth;
        // 保持显示中间图片
        this.currentOffset = this.containerWidth;
      }
    },

    // ===== 初始化 =====
    initSwiper() {
      this.resetView();
      this.imgShow = 0;
      this.currentOffset = this.containerWidth || 1;
      this.$nextTick(() => {
        this.updateContainerWidth();
        this.currentOffset = this.containerWidth;
      });
      this.clearAutoPlay();
      this.autoPlay();
    },

    // ===== 重置缩放 =====
    resetView() {
      this.scale = 1;
      this.dragX = 0;
      this.dragY = 0;
      this.lastX = 0;
      this.lastY = 0;
      this.dragging = false;
    },

    // ===== 自动播放 =====
    autoPlay() {
      if (this.imgList.length > 1) {
        this.timer = setInterval(() => {
          this.NextFun();
        }, 3000);
      }
    },
    clearAutoPlay() {
      if (this.timer) {
        clearInterval(this.timer);
        this.timer = null;
      }
    },
    MouseFun(type) {
      type === "移入" ? this.clearAutoPlay() : this.autoPlay();
    },
    handleMouseLeave() {
      this.MouseFun('移出');
      this.stopDrag();
    },

    // ===== 节流 =====
    throttle(fn) {
      if (this.isThrottling) return;
      this.isThrottling = true;
      fn();
      setTimeout(() => {
        this.isThrottling = false;
      }, 650);
    },

    // ===== 上一张 =====
    PrevFun() {
      if (this.imgList.length <= 1) return;
      this.isAnimating = true;
      this.resetView();
      
      // 向左移动一张
      this.currentOffset -= this.containerWidth;
    },

    // ===== 下一张 =====
    NextFun() {
      if (this.imgList.length <= 1) return;
      this.isAnimating = true;
      this.resetView();
      
      // 向右移动一张
      this.currentOffset += this.containerWidth;
    },

    // ===== 指示器点击 =====
    instFun(index) {
      if (index === this.imgShow || this.imgList.length <= 1) return;
      this.isAnimating = true;
      this.resetView();
      
      // 计算需要移动的距离
      let diff = index - this.imgShow;
      this.currentOffset += diff * this.containerWidth;
      this.imgShow = index;
      
      // 如果超出边界，立即重置位置
      if (this.currentOffset < 0 || this.currentOffset > this.containerWidth * 2) {
        this.$nextTick(() => {
          this.isAnimating = false;
          this.currentOffset = this.containerWidth;
          this.$nextTick(() => {
            this.isAnimating = true;
          });
        });
      }
    },

    // ===== 滚轮缩放 =====
    handleWheel(e) {
      e.preventDefault();
      if (!this.$refs.containerRef || this.imgList.length === 0) return;
      
      const rect = this.$refs.containerRef.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;

      const delta = e.deltaY > 0 ? -0.1 : 0.1;
      const newScale = Math.max(1, Math.min(3, this.scale + delta));

      if (newScale === this.scale) return;

      const ratio = newScale / this.scale;
      this.scale = newScale;

      if (this.scale === 1) {
        this.dragX = 0;
        this.dragY = 0;
        return;
      }

      const imgWidth = rect.width;
      const imgHeight = rect.height;
      const oldWidth = imgWidth * (this.scale / ratio);
      const oldHeight = imgHeight * (this.scale / ratio);
      
      this.dragX += (x / imgWidth) * (imgWidth - oldWidth);
      this.dragY += (y / imgHeight) * (imgHeight - oldHeight);
      
      this.clampDrag();
    },

    // ===== 鼠标拖拽 =====
    startDrag(e) {
      if (this.scale <= 1) return;
      e.preventDefault();
      this.dragging = true;
      this.lastX = e.clientX;
      this.lastY = e.clientY;
    },

    onDrag(e) {
      if (!this.dragging) return;
      e.preventDefault();

      const dx = e.clientX - this.lastX;
      const dy = e.clientY - this.lastY;
      this.lastX = e.clientX;
      this.lastY = e.clientY;

      this.dragX += dx;
      this.dragY += dy;
      this.clampDrag();
    },

    stopDrag() {
      this.dragging = false;
      this.lastX = 0;
      this.lastY = 0;
    },

    clampDrag() {
      if (!this.$refs.containerRef) return;
      const rect = this.$refs.containerRef.getBoundingClientRect();
      const maxX = (rect.width * this.scale - rect.width) / 2;
      const maxY = (rect.height * this.scale - rect.height) / 2;
      
      this.dragX = Math.max(-maxX, Math.min(maxX, this.dragX));
      this.dragY = Math.max(-maxY, Math.min(maxY, this.dragY));
    },
  },
};
</script>

<style scoped>
.SwiperBox {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  cursor: grab;
  user-select: none;
}

.img-container {
  width: 100%;
  height: 100%;
  overflow: hidden;
  position: relative;
}

.SwiperBox:active {
  cursor: grabbing;
}

.imgBox {
  display: flex;
  height: 100%;
  width: 100%;
  will-change: transform;
}

.imgBox img {
  flex-shrink: 0;
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.leftBtn, .rightBtn {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 40px;
  height: 40px;
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  z-index: 10;
  transition: all 0.3s;
  font-size: 20px;
  backdrop-filter: blur(4px);
}
.leftBtn { left: 16px; }
.rightBtn { right: 16px; }
.leftBtn:hover, .rightBtn:hover {
  background: rgba(0, 0, 0, 0.9);
  transform: translateY(-50%) scale(1.1);
  color: #00d4ff;
}

.instBox {
  position: absolute;
  left: 50%;
  bottom: 20px;
  transform: translateX(-50%);
  display: flex;
  gap: 10px;
  z-index: 10;
}
.inst {
  width: 10px;
  height: 10px;
  background: rgba(255, 255, 255, 0.4);
  border-radius: 50%;
  cursor: pointer;
  transition: all 0.3s;
}
.instActv {
  background: #ff4d4d;
  width: 24px;
  border-radius: 4px;
  box-shadow: 0 0 12px rgba(255, 77, 77, 0.6);
}
.inst:hover {
  background: rgba(255, 255, 255, 0.8);
  transform: scale(1.2);
}
</style>